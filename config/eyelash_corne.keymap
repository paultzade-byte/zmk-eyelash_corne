#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Індекси шарів — потрібні. Порядок = порядок оголошення шарів у keymap{}. */
#define GRAPHITE       0
#define GRAPHITE_ALTGR 1
#define DIGITS         2.overlay/.dts с.overlay/.dts с.overlay/.dts с.overlay/.dts с
#define SYMBOL         3
#define FUNCTION       4
#define CYRILLIC       5
#define CYR_ALTGR      6

/ {
    /*
     * ------------------------------------------------------------
     * CUSTOM BEHAVIORS
     * ------------------------------------------------------------
     */
    behaviors {
        /* Tap = ESC, Hold = FN layer */
        esc_fn: esc_fn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&mo>;
        };



    };

    /*
     * ------------------------------------------------------------
     * COMBOS
     * ------------------------------------------------------------
     * N R T S -> перемикання на CYRILLIC
     */
    combos {
        compatible = "zmk,combos";

        combo_cyrillic {
            timeout-ms = <80>;
            key-positions = <14 15 16 17>;
            bindings = <&to CYRILLIC>;
            layers = <GRAPHITE>;
        };

        combo_cyrillic_exit {
            timeout-ms = <80>;
            key-positions = <14 15 16 17>;
            bindings = <&to GRAPHITE>;
            layers = <CYRILLIC>;
        };
    };

    /*
     * ------------------------------------------------------------
     * KEYMAP
     * ------------------------------------------------------------
     */
    keymap {
        compatible = "zmk,keymap";

        graphite_layer {
            display-name = "GRAPH";
            bindings = <
                &esc_fn ESC 4  &kp B     &kp L  &kp D  &kp W  &kp Z &trans
                &kp APOS       &kp F     &kp O  &kp U  &kp J  &kp RET

                &kp LCTRL      &kp N     &kp R  &kp T  &kp S  &kp G &trans &trans &trans
                &kp Y          &kp H     &kp A  &kp E  &kp I  &mt LSHIFT COLON

                &kp LSHFT      &kp X     &kp M  &kp C  &kp V  &kp Q &trans &trans
                &kp K          &kp P     &kp DOT  &kp MINUS  &kp COMMA  &lt 3 UNDER

                &mt LALT LC(LS(LEFT))  &mt LSHIFT BSPC  &mt LCTRL TAB
                &sl RALT               &lt 2 SPACE
                /* GUI (hold) / Ctrl+Shift+Right */
                &mt LGUI LC(LS(RIGHT))
            >;
        };

        graphite_altgr_layer {
            display-name = "GRAPH_ALT";
            bindings = <
                &esc_fn ESC 4  &kp B     &kp L  &kp D  &kp W  &kp Z &trans
                &kp APOS       &kp F     &kp O  &kp U  &kp J  &kp RET

                &kp LCTRL      &kp N     &kp R  &kp T  &kp S  &kp G &trans &trans &trans
                &kp Y          &kp H     &kp A  &kp E  &kp I  &mt LSHIFT COLON

                &kp LSHFT      &kp X     &kp M  &kp C  &kp V  &kp Q &trans &trans
                &kp K          &kp P     &kp DOT  &kp MINUS  &kp COMMA  &kp UNDER

                &mt LALT LC(LS(LEFT))  &mt LSHIFT BSPC  &mt LCTRL TAB
                &sk RALT               &lt 2 SPACE  
                /* GUI (hold) / Ctrl+Shift+Right */
                &mt LGUI LC(LS(RIGHT))
            >;
        };

        digits_layer {
            display-name = "DIGITS";
            bindings = <
                &kp LC(HOME)  &kp HOME  &kp LC(LEFT)  &kp LC(RIGHT)  &kp END  &kp PG_UP &trans
                &kp FSLH      &kp N7    &kp N8        &kp N9         &kp LS(N8)  &trans

                &kp LC(END)   &kp LEFT  &kp UP        &kp DOWN       &kp RIGHT  &kp PG_DN &trans &trans &trans
                &kp MINUS     &kp N4    &kp N5        &kp N6         &kp PLUS   &kp LSHIFT

                &kp NUBS      &kp LBRC  &kp LS(N9)    &kp LS(N0)     &kp RBRC   &kp NUBS &trans &trans 
                &trans        &kp N0    &kp N1        &kp N2         &kp N3     &kp EQUAL  &trans

                &kp K_APP  &kp BSPC  &kp LS(DEL)
                &trans     &trans    &trans
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
                &trans     &trans     &none /* TODO: en dash – нема стандартного keycode,
                                                 потрібен окремий macro/unicode behavior */
                &kp EQUAL  &none /* TODO: em dash — те саме */  &kp BSLH

                &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &trans &trans

                &trans     &kp COMMA  &kp TILDE  &kp PIPE  &kp ASTRK  &kp FSLH &trans &trans &trans
                &kp MINUS  &kp DLLR   &kp PRCNT  &kp CARET /* TODO: дублює CARET вище, звір навмисно чи ні */
                &kp LBKT   &kp RBKT

                &trans     &kp LBRC   &kp COLON  &kp GRAVE  &kp RBRC  &trans &trans &trans
                &kp LT     &kp EXCL   &kp AT     &kp HASH   &kp GT    &kp UNDER

                &trans  &kp BSPC  &kp DEL
                &trans  &trans    &trans
            >;
        };

        function_layer {
            display-name = "FN";
            bindings = <
                &kp LC(HOME)  &kp HOME  &kp LC(LEFT)  &kp LC(RIGHT)  &kp END  &kp PG_UP &trans
                &kp F12       &kp F7    &kp F8        &kp F9         &trans   &trans

                &kp LC(END)   &kp LEFT  &kp UP        &kp DOWN       &kp RIGHT  &kp PG_DN &trans &trans &trans
                &kp F11       &kp F4    &kp F5        &kp F6         &trans     &trans

                &kp NUBS      &kp LBRC  &kp LS(N9)    &kp LS(N0)     &kp RBRC   &kp NUBS &trans &trans
                &trans        &kp F10   &kp F1        &kp F2         &kp F3     &trans  &trans

                &trans  &trans  &trans
                &trans  &trans  &trans
            >;
        };

        cyrillic_layer {
            display-name = "CYRILLIC";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                              &trans                 &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&td0       &kp A  &kp S  &kp D     &kp F  &kp G                     &trans   &trans   &trans        &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &trans                &trans                  &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &lt 3 SPACE                                               &lt 3 ENTER  &mo 2  &kp RALT
            >;
        };

        cyrillic_altgr_layer {
            display-name = "CYR_ALTGR";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                               &trans                &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&td0       &kp A  &kp S  &kp D     &kp F  &kp G                     &trans    &trans   &trans       &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &trans                 &trans                &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &lt 3 SPACE                                               &lt 3 ENTER  &mo 2  &kp RALT
            >;
        };
    };
};
